{
  "toolset_id": "customer_support",
  "tools": [
    {
      "name": "ticket_lookup",
      "description": "Retrieve ticket details by id, user email, or order id.",
      "base_latency_ms": 260,
      "jitter_ms": 80,
      "timeout_ms": 900,
      "schema_fields": [
        "ticket_id",
        "status",
        "priority",
        "summary",
        "owner"
      ],
      "fault_multipliers": {
        "rate_limit": 1.2
      }
    },
    {
      "name": "ticket_search",
      "description": "Search historical tickets by text, issue type, and tags.",
      "base_latency_ms": 330,
      "jitter_ms": 90,
      "timeout_ms": 1000,
      "schema_fields": [
        "results",
        "query",
        "count",
        "confidence"
      ],
      "fault_multipliers": {
        "network_failure": 1.1
      }
    },
    {
