{
  "toolset_id": "developer_tools",
  "tools": [
    {
      "name": "repo_code_search",
      "description": "Search repository code by symbol, text, and file pattern.",
      "base_latency_ms": 280,
      "jitter_ms": 85,
      "timeout_ms": 950,
      "schema_fields": [
        "matches",
        "query",
        "paths",
        "count"
      ],
      "fault_multipliers": {
        "rate_limit": 1.1
      }
    },
    {
      "name": "ast_symbol_index",
      "description": "Resolve symbol definitions, references, and signatures from an AST index.",
      "base_latency_ms": 340,
      "jitter_ms": 100,
      "timeout_ms": 1050,
      "schema_fields": [
        "symbol",
        "definition",
        "references",
        "signature"
      ],
      "fault_multipliers": {
        "contract_drift": 1.2
      }
    },
    {
      "name": "build_log_parser",
      "description": "Parse build output and extract failing targets, files, and error summaries.",
      "base_latency_ms": 300,
      "jitter_ms": 90,
      "timeout_ms": 1000,
      "schema_fields": [
        "target",
        "errors",
        "warnings",
        "summary"
      ],
      "fault_multipliers": {
        "malformed_schema": 1.2
      }
    },
    {
      "name": "test_failure_locator",
      "description": "Identify failing tests and map them to source files and stack traces.",
      "base_latency_ms": 320,
      "jitter_ms": 100,
      "timeout_ms": 1050,
      "schema_fields": [
        "tests",
        "stack_traces",
        "files",
        "summary"
      ],
      "fault_multipliers": {
        "timeout": 1.1
      }
    },
    {
      "name": "linter_fix_hint",
      "description": "Suggest likely lint fixes and formatting actions from diagnostics.",
      "base_latency_ms": 260,
      "jitter_ms": 80,
      "timeout_ms": 900,
      "schema_fields": [
        "rule_id",
        "message",
        "suggested_fix",
        "file"
      ],
      "fault_multipliers": {
        "malformed_schema": 1.3
      }
    },
    {
      "name": "dependency_graph",
      "description": "Resolve package dependency and import graph relationships.",
      "base_latency_ms": 410,
      "jitter_ms": 120,
      "timeout_ms": 1200,
      "schema_fields": [
        "nodes",
        "edges",
        "entrypoints",
        "cycles"
      ],
      "fault_multipliers": {
        "timeout": 1.2
      }
    },
    {
      "name": "api_schema_diff",
      "description": "Compare API schemas and report breaking vs non-breaking changes.",
      "base_latency_ms": 360,
      "jitter_ms": 110,
      "timeout_ms": 1100,
      "schema_fields": [
        "breaking_changes",
        "additions",
        "removals",
        "version"
      ],
      "fault_multipliers": {
        "contract_drift": 1.3
      }
    },
    {
      "name": "migration_guide_lookup",
      "description": "Retrieve migration notes and upgrade caveats for a package or framework.",
      "base_latency_ms": 290,
      "jitter_ms": 90,
      "timeout_ms": 950,
      "schema_fields": [
        "version",
        "notes",
        "breaking_changes",
        "links"
      ],
      "fault_multipliers": {
        "network_failure": 1.2
      }
    },
    {
      "name": "ci_status_reader",
      "description": "Read CI job states, failed steps, and job metadata.",
      "base_latency_ms": 240,
      "jitter_ms": 75,
      "timeout_ms": 850,
      "schema_fields": [
        "jobs",
        "status",
        "failed_steps",
        "run_id"
      ],
      "fault_multipliers": {
        "network_failure": 1.3
      }
    },
    {
      "name": "coverage_mapper",
      "description": "Map test coverage gaps to files, functions, and uncovered branches.",
      "base_latency_ms": 370,
      "jitter_ms": 110,
      "timeout_ms": 1100,
      "schema_fields": [
        "files",
        "functions",
        "branches",
        "coverage_percent"
      ],
      "fault_multipliers": {
        "timeout": 1.2
      }
    },
    {
      "name": "perf_trace_summarizer",
      "description": "Summarize runtime trace hotspots and latency contributors.",
      "base_latency_ms": 450,
      "jitter_ms": 130,
      "timeout_ms": 1300,
      "schema_fields": [
        "hotspots",
        "latency_ms",
        "calls",
        "recommendations"
      ],
      "fault_multipliers": {
        "timeout": 1.3
      }
    },
    {
      "name": "config_key_resolver",
      "description": "Find configuration keys, defaults, and environment overrides.",
      "base_latency_ms": 230,
      "jitter_ms": 70,
      "timeout_ms": 800,
      "schema_fields": [
        "key",
        "default",
        "source",
        "overrides"
      ],
      "fault_multipliers": {
        "contract_drift": 1.1
      }
    },
    {
      "name": "release_note_drafter",
      "description": "Draft release notes from merged changes and labels.",
      "base_latency_ms": 330,
      "jitter_ms": 100,
      "timeout_ms": 1000,
      "schema_fields": [
        "title",
        "highlights",
        "breaking_changes",
        "audience"
      ],
      "fault_multipliers": {
        "malformed_schema": 1.2
      }
    },
    {
      "name": "incident_runbook_lookup",
      "description": "Look up engineering incident runbook sections by symptom.",
      "base_latency_ms": 250,
      "jitter_ms": 80,
      "timeout_ms": 850,
      "schema_fields": [
        "runbook",
        "steps",
        "owners",
        "links"
      ],
      "fault_multipliers": {
        "network_failure": 1.1
      }
    },
    {
      "name": "query_plan_inspector",
      "description": "Inspect database query plans and identify slow operators.",
      "base_latency_ms": 390,
      "jitter_ms": 115,
      "timeout_ms": 1150,
      "schema_fields": [
        "plan",
        "cost",
        "slow_operators",
        "indexes"
      ],
      "fault_multipliers": {
        "timeout": 1.2
      }
    },
    {
      "name": "feature_flag_audit",
      "description": "Retrieve feature flag ownership, rollout state, and dependencies.",
      "base_latency_ms": 270,
      "jitter_ms": 85,
      "timeout_ms": 900,
      "schema_fields": [
        "flag",
        "owner",
        "rollout",
        "dependencies"
      ],
      "fault_multipliers": {
        "rate_limit": 1.1
      }
    }
  ],
  "tasks": [
