      "jitter_ms": 100,
      "timeout_ms": 1000,
      "schema_fields": [
        "chargebacks",
        "ratio",
        "period"
      ],
      "fault_multipliers": {
        "rate_limit": 1.2
      }
    },
    {
      "name": "payment_network_status",
