        "window",
        "count",
        "limit",
        "breach"
      ],
      "fault_multipliers": {
        "contract_drift": 1.1
      }
    },
    {
      "name": "behavioral_anomaly",
      "description": "Detect unusual behavior against user baseline.",
      "base_latency_ms": 360,
      "jitter_ms": 110,
      "timeout_ms": 1100,
      "schema_fields": [
        "anomaly_score",
        "signals",
        "explanation"
      ],
      "fault_multipliers": {
        "timeout": 1.2
      }
