{
  "toolset_id": "fintech_risk",
  "tools": [
    {
      "name": "kyc_profile_lookup",
      "description": "Fetch customer KYC profile and verification status.",
      "base_latency_ms": 260,
      "jitter_ms": 80,
      "timeout_ms": 900,
      "schema_fields": [
        "customer_id",
        "kyc_status",
        "risk_tier"
      ],
      "fault_multipliers": {
        "network_failure": 1.1
      }
    },
    {
      "name": "aml_screening",
      "description": "Screen customer/entity against sanctions and watchlists.",
      "base_latency_ms": 390,
      "jitter_ms": 120,
      "timeout_ms": 1200,
      "schema_fields": [
        "match",
        "score",
        "watchlist",
        "reason"
      ],
      "fault_multipliers": {
        "timeout": 1.2
      }
    },
    {
      "name": "transaction_graph",
      "description": "Build graph of counterparties and money flow paths.",
      "base_latency_ms": 520,
      "jitter_ms": 160,
      "timeout_ms": 1450,
      "schema_fields": [
        "nodes",
        "edges",
        "anomaly_score"
      ],
      "fault_multipliers": {
        "timeout": 1.3
      }
    },
    {
      "name": "device_fingerprint",
      "description": "Assess device trust from hardware and browser signals.",
      "base_latency_ms": 240,
      "jitter_ms": 80,
      "timeout_ms": 850,
      "schema_fields": [
        "device_id",
        "trust_score",
        "flags"
      ],
      "fault_multipliers": {
        "malformed_schema": 1.2
      }
    },
    {
      "name": "ip_geo_risk",
