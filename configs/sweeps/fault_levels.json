{
  "name": "fault-level-sweep",
  "description": "Compares policy robustness under mild, medium, and severe fault rates.",
  "seeds": [1, 2, 3, 4, 5],
  "scenarios": [
    {
      "id": "mild",
      "label": "Mild Faults",
      "config_overrides": {
        "fault_probabilities": {
          "timeout": 0.03,
          "rate_limit": 0.02,
          "malformed_schema": 0.02,
          "contract_drift": 0.01,
          "network_failure": 0.02
        }
      }
    },
    {
      "id": "medium",
      "label": "Medium Faults",
      "config_overrides": {
        "fault_probabilities": {
          "timeout": 0.08,
          "rate_limit": 0.07,
          "malformed_schema": 0.06,
          "contract_drift": 0.04,
          "network_failure": 0.05
        }
      }
    },
    {
      "id": "severe",
      "label": "Severe Faults",
      "config_overrides": {
        "fault_probabilities": {
          "timeout": 0.16,
          "rate_limit": 0.14,
          "malformed_schema": 0.12,
          "contract_drift": 0.1,
          "network_failure": 0.09
        },
        "max_attempts": 5,
        "time_budget_ms": 2000
      }
    }
  ]
}
