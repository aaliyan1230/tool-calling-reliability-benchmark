      "allowed_target_rules": {
        "airline": ["airline.confirm_before_write", "airline.payment_profile", "airline.cancel.reason", "airline.cancel.eligibility"],
        "retail": ["retail.confirm_before_write", "retail.payment_profile", "retail.order_state"]
      }
    }
